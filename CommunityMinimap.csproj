<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>CommunityMinimap</AssemblyName>
    <RootNamespace>CommunityMinimap</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GameDirectory)' == ''">
    <GameDirectory>$(ProgramFilesX86)\Steam\steamapps\common\TheLongDark</GameDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(GameDirectory)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDirectory)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(GameDirectory)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppTLD.Addressables" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\Il2CppTLD.Addressables.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\UnityEngine.dll" Private="false" />
    <Reference Include="Unity.Addressables" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\Unity.Addressables.dll" Private="false" />
    <Reference Include="Unity.ResourceManager" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameDirectory)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="ModSettings" HintPath="$(GameDirectory)\Mods\ModSettings.dll" Private="false" />
  </ItemGroup>
</Project>
